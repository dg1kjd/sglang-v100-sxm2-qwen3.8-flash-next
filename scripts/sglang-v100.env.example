# Configuration for the sglang-v100 systemd unit. Install at /etc/sglang-v100.env.
#
# Pinning the venv and the model here rather than relying on a shell's cwd is
# the point of this file: the serve script derives its repo root from its own
# location, so running the copy in a stale checkout silently serves stale code
# against whichever venv happens to be active.

# 'mtp' enables the built-in MTP draft head (recommended). 'target' disables
# speculation.
SGLANG_V100_MODE=mtp

# Absolute path to the venv built per docs/v100/INSTALL.md.
SGLANG_V100_VENV=/home/nvidia/sglang-v100-venv

# The NVFP4 checkout (see the README's "Get the model").
FLASH_NEXT_MODEL=/home/nvidia/models/Qwen3.8-Flash-Next-NVFP4

FLASH_NEXT_PORT=30000
FLASH_NEXT_GPUS=0,1,2,3

# Host-RAM cache tier, in GB. The dominant term in host memory use; turn it
# down on a smaller box.
FLASH_NEXT_HICACHE=8

# L3 spill directory for the hierarchical cache's file backend. Without it the
# backend uses a temp path, so the disk tier is cold after every restart.
SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR=/home/nvidia/hicache_storage
